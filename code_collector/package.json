{
  "name": "code-collector",
  "version": "1.0.0-A",
  "description": "Capture code blocks from AI chat pages. Local-first. Cloud optional. Hardened 2026-03-23.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build": "npm run build:mac && npm run build:win && npm run build:linux",
    "lint": "eslint main.js settings.js preload.js test --ext .js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit test/main.test.js",
    "test:torture": "jest --runInBand --forceExit test/torture.test.js",
    "test:watch": "jest --watch",
    "prepack": "npm test"
  },
  "dependencies": {
    "electron-store": "^7.0.3"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "jest-environment-jsdom": "^29.7.0"
  },
  "build": {
    "appId": "ai.pubcast.code-collector",
    "productName": "Code Collector",
    "copyright": "Copyright \u00a9 2026 Rear View Foresight LLC",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
