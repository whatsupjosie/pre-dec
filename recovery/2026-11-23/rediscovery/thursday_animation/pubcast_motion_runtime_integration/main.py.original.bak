@app.get("/api/me")
async def get_me(request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    f = DATA_DIR / "users" / f"{uid}.json"
    data = read_json(f) if f.exists() else {"user_id": uid, "display_name": "New User"}
    return JSONResponse(data)


@app.get("/api/state/user")
async def read_user_state(request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    f = DATA_DIR / "users" / f"{uid}.json"
    return read_json(f) if f.exists() else {"user_id": uid, "display_name": "New User"}


@app.post("/api/state/user")
async def save_user_state(request: Request, response: Response, payload: Dict[str, Any]):
    uid = _get_or_set_uid(request, response)
    user_file = DATA_DIR / "users" / f"{uid}.json"
    current = read_json(user_file) if user_file.exists() else {}
    current.update(payload or {})
    write_json(user_file, current)
    await hub.broadcast_presence_update(uid, current.get("display_name", "User"))
    return {"ok": True}


@app.get("/api/docs/bootstrap")
async def docs_bootstrap(request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    return docs.load_state(DATA_DIR, uid)


@app.post("/api/docs/folders")
async def create_docs_folder(request: Request, response: Response, payload: Dict[str, Any]):
    uid = _get_or_set_uid(request, response)
    folder = docs.create_folder(
        DATA_DIR,
        uid,
        str(payload.get("name") or "Untitled Folder"),
        str(payload.get("kind") or "document"),
    )
    return {"ok": True, "folder": folder}


@app.get("/api/docs/documents")
async def list_docs_documents(request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    return {"documents": docs.list_documents(DATA_DIR, uid)}


@app.get("/api/docs/documents/{doc_id}")
async def get_docs_document(doc_id: str, request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    try:
        return docs.get_document(DATA_DIR, uid, doc_id)
    except KeyError:
        return JSONResponse({"error": "not found"}, status_code=404)


@app.post("/api/docs/documents")
async def create_docs_document(request: Request, response: Response, payload: Dict[str, Any]):
    uid = _get_or_set_uid(request, response)
    doc = docs.upsert_document(DATA_DIR, uid, payload or {})
    return {"ok": True, "document": doc}


@app.put("/api/docs/documents/{doc_id}")
async def update_docs_document(doc_id: str, request: Request, response: Response, payload: Dict[str, Any]):
    uid = _get_or_set_uid(request, response)
    merged = {**(payload or {}), "doc_id": doc_id}
    doc = docs.upsert_document(DATA_DIR, uid, merged)
    return {"ok": True, "document": doc}


@app.post("/api/docs/import")
async def import_docs_document(request: Request, response: Response, file: UploadFile = File(...)):
    uid = _get_or_set_uid(request, response)
    raw = await file.read()
    content = raw.decode("utf-8", errors="ignore")
    doc = docs.import_document(DATA_DIR, uid, file.filename or "import.txt", content)
    return {"ok": True, "document": doc}


@app.get("/api/docs/documents/{doc_id}/export")
async def export_docs_document(doc_id: str, request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    try:
        exported = docs.export_document(DATA_DIR, uid, doc_id)
    except KeyError:
        return JSONResponse({"error": "not found"}, status_code=404)
    headers = {"Content-Disposition": f"attachment; filename={exported['filename']}"}
    return Response(content=exported["content"], media_type="text/plain; charset=utf-8", headers=headers)


@app.get("/api/docs/messages")
async def list_docs_messages(request: Request, response: Response):
    uid = _get_or_set_uid(request, response)
    return {"messages": docs.list_messages(DATA_DIR, uid)}


@app.post("/api/docs/messages/send")
async def send_docs_message(request: Request, response: Response, payload: Dict[str, Any]):
    uid = _get_or_set_uid(request, response)
    msg = docs.send_message(DATA_DIR, uid, payload or {})
    return {"ok": True, "message": msg}


