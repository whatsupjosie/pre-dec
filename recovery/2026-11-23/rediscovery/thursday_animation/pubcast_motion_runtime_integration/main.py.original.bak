# â”€â”€ Service singletons (created at startup) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
hub: Hub
cam: CameraManager
rec: RecordingService
bot_mgr: BotManager
room_mgr: RoomManager
cred_store: CredentialStore
vision_mgr: Optional[PubcastVisionManager] = None
jeremy: Optional[JeremyCricket] = None
MEMORY_SNAPSHOT_PATH = DATA_DIR / "memory_snapshot.json"


async def _build_jeremy(hub: Hub, bot_manager: BotManager) -> JeremyCricket:
    memory = UniversalMemorySystem()
    restored = memory.restore(MEMORY_SNAPSHOT_PATH)

    for config in bot_manager.list_configs():
        memory.register_character(
            CharacterProfile(
                character_id=bot_manager.bot_user_id(config.bot_id),
                name=config.name,
                role="cohost",
                personality={"provider": config.provider.value},
            )
        )

    jeremy_instance = await create_jeremy_cricket(
        memory_system=memory,
        bot_manager=bot_manager,
        hub=hub,
        config=JeremyConfig(),
    )
    bot_manager.attach_jeremy(jeremy_instance)
    hub.set_jeremy(jeremy_instance)
    if restored:
        hub.set_startup_notice(f"Memory restored: loaded {restored} saved entries from previous sessions.")
    else:
        hub.set_startup_notice("Memory is live for this chat. Saved context will be available after future restarts.")
    return jeremy_instance


@app.on_event("startup")
async def _startup() -> None:
    global hub, cam, rec, bot_mgr, room_mgr, cred_store, vision_mgr, jeremy

    ensure_dirs(DATA_DIR, ASSETS_DIR)
    ai_runtime = validate_ai_runtime_config(load_ai_runtime_config(BASE_DIR))

    hub        = Hub(DATA_DIR)
    cam        = create_default_cameras()
    rec        = RecordingService(DATA_DIR / "recordings", cam)
    bot_mgr    = BotManager(DATA_DIR, hub)
    hub.set_bot_manager(bot_mgr)
    room_mgr   = RoomManager()
    cred_store = CredentialStore(DATA_DIR / "credentials")
    vision_mgr = create_vision_manager(cam, DATA_DIR, broadcast_event=hub.broadcast_system_event)
    jeremy     = await _build_jeremy(hub, bot_mgr)

    for room_id in hub.active_rooms():
        await jeremy.watch_room(room_id)

    # Register standard encoding profiles
    rec.register_profile(EncodingProfile(
        profile_id="1080p30",
        name="1080p 30fps",
        container=ContainerFormat.MP4,
        video_codec="h264",
        audio_codec="aac",
        video_bitrate="6000k",
        audio_bitrate="192k",
        resolution="1920x1080",
        frame_rate="30",
        description="Broadcast-quality HD",
    ))
    rec.register_profile(EncodingProfile(
        profile_id="480i",
        name="480i Fallback",
        container=ContainerFormat.MP4,
        video_codec="h264",
        audio_codec="aac",
        video_bitrate="2000k",
        audio_bitrate="128k",
        resolution="854x480",
        frame_rate="30",
        description="Low-bandwidth fallback",
    ))
    rec.register_profile(EncodingProfile(
        profile_id="audio_only",
        name="Audio Only",
        container=ContainerFormat.WAV,
        video_codec=None,
        audio_codec="pcm_s16le",
        video_bitrate=None,
        audio_bitrate=None,
        resolution=None,
        frame_rate=None,
        description="Raw audio recording",
        is_audio_only=True,
    ))

    logger.info(
        "PubCast AI started. DATA=%s AI_PROFILE=%s AI_BACKEND=%s AI_MODEL=%s",
        DATA_DIR,
        ai_runtime.active_profile,
        ai_runtime.active().backend,
        ai_runtime.active().model,
    )


@app.on_event("shutdown")
async def _shutdown() -> None:
    manager = globals().get("bot_mgr")
    conductor = globals().get("jeremy")

    if conductor is not None:
        await conductor.shutdown()
        conductor.memory.serialize(MEMORY_SNAPSHOT_PATH)

    if manager is not None:
        await manager.shutdown()


