@app.get("/api/health")
async def health():
    providers = _detect_cloud_providers()
    vision = _get_vision_manager()
    return {
        "status": "ok",
        "timestamp": time.time(),
        "cameras": {
            "program": cam.get_program_source().source_id if cam.get_program_source() else None,
            "preview": cam.get_preview_source().source_id if cam.get_preview_source() else None,
            "count":   len(cam.list_sources()),
        },
        "vision": {
            "enabled": vision is not None,
            "broadcasting": bool(vision.is_broadcasting) if vision else False,
            "primary_camera": vision.primary_camera if vision else None,
            "tracked_cameras": len(vision.vision_cameras) if vision else 0,
        },
        "recording": {
            "active_sessions": sum(1 for s in rec.list_sessions() if s.state.value == "active"),
        },
        "ai_providers": providers,
        "ws_rooms": {r: len(conns) for r, conns in hub.rooms.items()},
        "jeremy": jeremy.get_stats() if jeremy else None,
    }


