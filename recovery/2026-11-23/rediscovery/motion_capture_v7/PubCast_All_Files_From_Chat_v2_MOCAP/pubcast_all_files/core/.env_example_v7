# PubCast AI v7.0 - Environment Configuration
# Copy this file to .env and customize for your environment

# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────

# Server host and port
HOST=0.0.0.0
PORT=8000

# Data directory
DATA_DIR=./data

# ─────────────────────────────────────────────
# OLLAMA CONFIGURATION (Local AI)
# ─────────────────────────────────────────────

# Ollama server URL
OLLAMA_HOST=http://localhost:11434

# Preferred model (gemma4:4b, mistral, llama3, phi3)
OLLAMA_MODEL=gemma4:4b

# Ollama timeout (seconds)
OLLAMA_TIMEOUT=60

# Bot provider (ollama, openai, anthropic)
BOT_PROVIDER=ollama

# ─────────────────────────────────────────────
# PETE ENHANCED CONFIGURATION
# ─────────────────────────────────────────────

# Rust voxel engine connection
RUST_ENGINE_HOST=localhost
RUST_ENGINE_PORT=9000

# WebRTC streaming URL
WEBRTC_STREAM_URL=ws://localhost:8001/stream

# Enable adaptive quality (auto-adjust based on performance)
ENABLE_ADAPTIVE_QUALITY=true

# ─────────────────────────────────────────────
# STUDIO CONTROL ROOM CONFIGURATION
# ─────────────────────────────────────────────

# Dead Man's Switch auto-save interval (seconds)
DEAD_MAN_SWITCH_INTERVAL=60.0

# Audio monitoring update rate (seconds, 0.1 = 10 Hz)
AUDIO_UPDATE_INTERVAL=0.1

# Enable AI voice cues during countdown
ENABLE_VOICE_CUES=true

# Voice for countdown (pete, detective_humphrey, etc.)
COUNTDOWN_VOICE=pete

# ─────────────────────────────────────────────
# VOXEL ASSET SYSTEM CONFIGURATION
# ─────────────────────────────────────────────

# Asset library path
VOXEL_LIBRARY_PATH=./data/voxel_asset_library.json

# Maximum instances per scene
MAX_SCENE_INSTANCES=1000

# Maximum memory usage per scene (MB)
MAX_SCENE_MEMORY_MB=512

# Enable Level of Detail (LOD) system
ENABLE_LOD=true

# Culling distance (units)
CULLING_DISTANCE=50.0

# ─────────────────────────────────────────────
# AVATAR SYSTEM CONFIGURATION
# ─────────────────────────────────────────────

# Default avatar preset (neon_yellow_a, neon_blue_b, neon_pink_c)
DEFAULT_AVATAR=neon_yellow_a

# Avatar data directory
AVATAR_DATA_DIR=./data/avatars

# ─────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/pubcast.log

# Enable colored console output
LOG_COLOR=true

# ─────────────────────────────────────────────
# DEVELOPMENT / DEBUGGING
# ─────────────────────────────────────────────

# Enable debug mode
DEBUG=false

# Enable auto-reload (development only)
AUTO_RELOAD=false

# Enable detailed error traces
SHOW_TRACES=true

# ─────────────────────────────────────────────
# OPTIONAL: PAID API KEYS (if not using Ollama)
# ─────────────────────────────────────────────

# OpenAI API key (if BOT_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Anthropic API key (if BOT_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
