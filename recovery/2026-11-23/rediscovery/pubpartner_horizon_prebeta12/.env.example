# PubPartner / PubCast environment configuration
# The canonical launcher creates a persistent signing secret and local owner
# setup automatically. Do not put real secrets in files you share.

# Optional overrides
PUBCAST_JWT_EXPIRE_MINUTES=1440
PUBCAST_JWT_ISSUER=pubpartner-local
PUBCAST_JWT_AUDIENCE=pubpartner-ui
PUBCAST_PBKDF2_ITERATIONS=600000

# Product launcher enables this automatically. Set 0 only in isolated tests.
PUBCAST_ENFORCE_AUTH=1

# Local browser origin. Network deployment requires explicit review.
PUBCAST_ALLOWED_ORIGINS=http://127.0.0.1:8000
PUBCAST_HOST=127.0.0.1
PUBCAST_PORT=8000
PUBCAST_DEBUG=0

PUBCAST_DATA_DIR=data
PUBCAST_ASSETS_DIR=assets
PUBCAST_STATIC_DIR=static

# Optional AI providers
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional TTS
PUBCAST_LARYNX_HOST=127.0.0.1
PUBCAST_LARYNX_PORT=5002
PUBCAST_PIPER_MODEL=en_US-lessac-medium

PUBCAST_MAX_RECORDING_HOURS=4

# Optional OpenCode Zen host key. The encrypted UI BYOK path is preferred.
# Big Pickle model ID: big-pickle
# OPENCODE_ZEN_API_KEY=
